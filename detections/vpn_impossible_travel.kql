// VPN impossible travel detection
//
// Correlate VPN authentication events occurring from geographically
// inconsistent locations within a short period.

CommonSecurityLog
| where TimeGenerated >= ago(24h)
| where DeviceVendor has_any ("VPN", "Firewall")
| summarize
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated),
    SourceIPs = make_set(SourceIP, 20),
    Countries = make_set(SourceCountry, 20),
    EventCount = count()
    by DestinationUserName
| where array_length(Countries) > 1
| order by EventCount desc
